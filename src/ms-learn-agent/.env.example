# For local runs only. In Foundry, FOUNDRY_PROJECT_ENDPOINT is injected by the
# platform and the other values come from azure.yaml.
FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="<model-deployment-name>"
# After `azd up`, read this from `azd env get-values` (TOOLBOX_AGENT_TOOLS_MCP_ENDPOINT).
TOOLBOX_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/agent-tools/mcp?api-version=v1"
